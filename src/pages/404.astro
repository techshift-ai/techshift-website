---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import { site } from '../site.config';
---

<BaseLayout
  title={`Page not found | ${site.name}`}
  description="The page you are looking for does not exist or has moved."
  canonical="/404"
  noindex
>
  <Section labelledby="nf-heading" class="min-h-[60svh] content-center text-center">
    <p class="text-sm font-medium tracking-widest text-ink-muted uppercase">404</p>
    <h1 id="nf-heading" class="mt-4 text-4xl sm:text-5xl">
      This page does not exist.
    </h1>
    <p class="mx-auto mt-4 max-w-md text-ink-muted">
      The link may be old or mistyped. Head back to the homepage to find what you need.
    </p>
    <div class="mt-8">
      <Button href="/">Back to homepage</Button>
    </div>
  </Section>
</BaseLayout>
