---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageContent from '../components/home/PageContent.astro';
import { faqItems } from '../data/faq';
import { services } from '../data/services';
import { faqPage, service } from '../lib/schema';
import { site } from '../site.config';

const schema = [
  faqPage(faqItems.map((item) => ({ question: item.question, answer: item.answer }))),
  ...services.map((item) =>
    service({ name: item.name, description: item.description, path: item.path }),
  ),
];
---

<BaseLayout title={site.title} description={site.description} schema={schema}>
  <PageContent />
</BaseLayout>
