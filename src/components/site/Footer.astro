---
import Logo from '../brand/Logo.astro';
import { site } from '../../site.config';
---

<footer class="site-footer on-dark">
  <div class="wrap">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" aria-label="Techshift home">
          <Logo />
        </a>
        <p>Your trusted AI technology partner.</p>
      </div>
      <div class="footer-cols">
        <nav aria-label="Footer">
          <h2>Explore</h2>
          <ul>
            <li>
              <a href="#services">Services</a>
            </li>
            <li>
              <a href="#systems">Systems</a>
            </li>
            <li>
              <a href="#how-we-work">How we work</a>
            </li>
            <li>
              <a href="#about">About</a>
            </li>
            <li>
              <a href="#faq">FAQ</a>
            </li>
          </ul>
        </nav>
        <div>
          <h2>Contact</h2>
          <ul>
            <li>
              <a href={site.bookingFallbackUrl} data-book>
                Book a free consultation
              </a>
            </li>
            <li>
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </li>
          </ul>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; 2026 Techshift. All rights reserved.</span>
      <span translate="no">techshift.ai</span>
    </div>
  </div>
</footer>
